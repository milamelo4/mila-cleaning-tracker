rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{businessId} {

      function isMember() {
        return request.auth != null
          && exists(
            /databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)
          );
      }

      function isAdmin() {
        return isMember()
          && get(
            /databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)
          ).data.role == "admin";
      }

      function isHelper() {
        return isMember()
          && get(
            /databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)
          ).data.role == "helper";
      }

      match /members/{memberId} {
        allow get: if isAdmin()
          || (
            request.auth != null
            && request.auth.uid == memberId
          );

        allow list: if isAdmin();

        allow create, update, delete: if isAdmin();
      }

      match /clients/{clientId} {

        function validClient(data) {
          return data.keys().hasAll([
              "id",
              "name",
              "phone",
              "address",
              "gateCode",
              "billingType",
              "pricePerCleaning",
              "biweeklyRate",
              "biweeklyAnchorDate",
              "monthlyRate",
              "startDate",
              "estimatedHours",
              "frequency",
              "helperNeeded",
              "assignedHelpers",
              "notes",
              "pricingNotes",
              "cleaningInstructions",
              "active"
            ])
            && data.keys().hasOnly([
              "id",
              "name",
              "phone",
              "address",
              "gateCode",
              "billingType",
              "pricePerCleaning",
              "biweeklyRate",
              "biweeklyAnchorDate",
              "monthlyRate",
              "startDate",
              "estimatedHours",
              "frequency",
              "helperNeeded",
              "assignedHelpers",
              "notes",
              "pricingNotes",
              "cleaningInstructions",
              "active"
            ])

            && data.id is number
            && data.name is string
            && data.phone is string
            && data.address is string
            && data.gateCode is string

            && data.billingType is string
            && data.billingType in [
              "Per Cleaning",
              "Biweekly",
              "Fixed Monthly"
            ]

            && data.pricePerCleaning is number
            && data.pricePerCleaning >= 0
            && data.pricePerCleaning <= 10000

            && data.biweeklyRate is number
            && data.biweeklyRate >= 0
            && data.biweeklyRate <= 50000

            && data.biweeklyAnchorDate is string

            && data.monthlyRate is number
            && data.monthlyRate >= 0
            && data.monthlyRate <= 50000

            && (
              (
                data.billingType == "Per Cleaning"
                && data.pricePerCleaning >= 0.01
                && data.biweeklyRate == 0
                && data.biweeklyAnchorDate == ""
                && data.monthlyRate == 0
              )
              ||
              (
                data.billingType == "Biweekly"
                && data.pricePerCleaning >= 0.01
                && data.biweeklyRate >= 0.01
                && data.biweeklyAnchorDate.matches(
                  "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                )
                && data.monthlyRate == 0
              )
              ||
              (
                data.billingType == "Fixed Monthly"
                && data.monthlyRate >= 0.01
                && data.biweeklyRate == 0
                && data.biweeklyAnchorDate == ""
              )
            )

            && data.startDate is string
            && data.estimatedHours is number
            && data.frequency is string
            && data.helperNeeded is bool
            && data.assignedHelpers is list

            && data.notes is string
            && data.notes.size() <= 1000

            && data.pricingNotes is string
            && data.pricingNotes.size() <= 1000

            && data.cleaningInstructions is string
            && data.cleaningInstructions.size() <= 1000

            && data.active is bool;
        }

        allow read: if isAdmin();

        allow create, update: if isAdmin()
          && validClient(request.resource.data);

        allow delete: if isAdmin();
      }

      match /cleanings/{cleaningId} {

        function validCleaning(data) {
          return data.keys().hasAll([
              "clientId",
              "clientName",
              "clientPhone",
              "clientAddress",
              "clientGateCode",
              "clientNotes",
              "date",
              "startTime",
              "estimatedHours",
              "assignedHelpers",
              "status",
              "notes"
            ])
            && data.keys().hasOnly([
              "clientId",
              "clientName",
              "clientPhone",
              "clientAddress",
              "clientGateCode",
              "clientNotes",
              "date",
              "startTime",
              "estimatedHours",
              "assignedHelpers",
              "status",
              "notes"
            ])

            && data.clientId is string
            && data.clientId.size() > 0
            && exists(
              /databases/$(database)/documents/businesses/$(businessId)/clients/$(data.clientId)
            )

            && data.clientName is string
            && data.clientName.size() > 0
            && data.clientName.size() <= 100

            && data.clientPhone is string
            && data.clientPhone.size() <= 50

            && data.clientAddress is string
            && data.clientAddress.size() <= 300

            && data.clientGateCode is string
            && data.clientGateCode.size() <= 100

            && data.clientNotes is string
            && data.clientNotes.size() <= 1000

            && data.date is string
            && data.date.matches(
              "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            )

            && data.startTime is string
            && data.startTime.matches(
              "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            )

            && data.estimatedHours is number
            && data.estimatedHours >= 0.5
            && data.estimatedHours <= 24

            && data.assignedHelpers is list
            && data.assignedHelpers.size() <= 20

            && data.status is string
            && data.status in [
              "Scheduled",
              "Completed",
              "Cancelled"
            ]

            && data.notes is string
            && data.notes.size() <= 1000;
        }

        allow read: if isAdmin()
          || (
            isHelper()
            && request.auth.uid
              in resource.data.assignedHelpers
          );

        allow create, update: if isAdmin()
          && validCleaning(request.resource.data);

        allow delete: if isAdmin();
      }

      match /payments/{paymentId} {

        function isBiweeklyPayment(data) {
          return data.keys().hasAll([
              "billingType",
              "periodStart",
              "periodEnd",
              "includedCleaningIds"
            ])

            && data.billingType is string
            && data.billingType == "Biweekly"

            && data.cleaningId == ""
            && data.cleaningDate == ""

            && data.periodStart is string
            && data.periodStart.matches(
              "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            )

            && data.periodEnd is string
            && data.periodEnd.matches(
              "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            )

            && data.includedCleaningIds is list
            && data.includedCleaningIds.size() >= 1
            && data.includedCleaningIds.size() <= 50;
        }

        function isCleaningLinkedPayment(data) {
          return data.cleaningId.size() > 0

            && data.cleaningDate.matches(
              "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            )

            && !data.keys().hasAny([
              "periodStart",
              "periodEnd",
              "includedCleaningIds"
            ])

            && (
              !data.keys().hasAny([
                "billingType"
              ])
              ||
              data.billingType in [
                "Per Cleaning",
                "Fixed Monthly"
              ]
            );
        }

        function validPaymentFields(data) {
          return data.keys().hasAll([
              "cleaningId",
              "clientId",
              "clientName",
              "cleaningDate",
              "amountCharged",
              "actualHours",
              "helperPayout",
              "paid",
              "paidDate",
              "notes"
            ])

            && data.keys().hasOnly([
              "cleaningId",
              "clientId",
              "clientName",
              "cleaningDate",
              "billingType",
              "periodStart",
              "periodEnd",
              "includedCleaningIds",
              "amountCharged",
              "actualHours",
              "helperPayout",
              "paid",
              "paidDate",
              "notes"
            ])

            && data.cleaningId is string

            && data.clientId is string
            && data.clientId.size() > 0

            && data.clientName is string
            && data.clientName.size() >= 1
            && data.clientName.size() <= 100

            && data.cleaningDate is string

            && data.amountCharged is number
            && data.amountCharged >= 0.01
            && data.amountCharged <= 50000

            && data.actualHours is number
            && data.actualHours >= 0.25
            && data.actualHours <= 744

            && data.helperPayout is number
            && data.helperPayout >= 0
            && data.helperPayout <= data.amountCharged

            && data.paid is bool

            && data.paidDate is string
            && (
              (
                data.paid == false
                && data.paidDate == ""
              )
              ||
              (
                data.paid == true
                && data.paidDate.matches(
                  "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                )
              )
            )

            && data.notes is string
            && data.notes.size() <= 1000

            && (
              isCleaningLinkedPayment(data)
              ||
              isBiweeklyPayment(data)
            );
        }

        function validCleaningPaymentLinks(data) {
          let cleaningAfter = getAfter(
            /databases/$(database)/documents/businesses/$(businessId)/cleanings/$(data.cleaningId)
          );

          let client = get(
            /databases/$(database)/documents/businesses/$(businessId)/clients/$(data.clientId)
          );

          return cleaningAfter.data.clientId
              == data.clientId
            && cleaningAfter.data.date
              == data.cleaningDate
            && cleaningAfter.data.status
              == "Completed"
            && client.data.name
              == data.clientName;
        }

        function validBiweeklyPaymentLinks(data) {
          let client = get(
            /databases/$(database)/documents/businesses/$(businessId)/clients/$(data.clientId)
          );

          return client.data.name
              == data.clientName
            && client.data.billingType
              == "Biweekly";
        }

        function validPaymentLinks(data) {
          return (
              isCleaningLinkedPayment(data)
              && validCleaningPaymentLinks(data)
            )
            ||
            (
              isBiweeklyPayment(data)
              && validBiweeklyPaymentLinks(data)
            );
        }

        allow read: if isAdmin();

        allow create: if isAdmin()
          && validPaymentFields(
            request.resource.data
          )
          && validPaymentLinks(
            request.resource.data
          );

        allow update: if isAdmin()
          && validPaymentFields(
            request.resource.data
          )
          && validPaymentLinks(
            request.resource.data
          )

          && request.resource.data.clientId
            == resource.data.clientId

          && request.resource.data.clientName
            == resource.data.clientName

          && request.resource.data.cleaningId
            == resource.data.cleaningId

          && request.resource.data.cleaningDate
            == resource.data.cleaningDate;

        allow delete: if isAdmin();
      }

      match /savedAssistantAnswers/{answerId} {

        function validSavedAnswer(data) {
          return data.keys().hasAll([
              "question",
              "answer",
              "savedBy",
              "savedAt"
            ])
            && data.keys().hasOnly([
              "question",
              "answer",
              "savedBy",
              "savedAt"
            ])

            && data.question is string
            && data.question.size() > 0
            && data.question.size() <= 2000

            && data.answer is string
            && data.answer.size() > 0
            && data.answer.size() <= 20000

            && data.savedBy is string
            && data.savedBy == request.auth.uid

            && data.savedAt is timestamp;
        }

        allow read: if isAdmin();

        allow create: if isAdmin()
          && validSavedAnswer(request.resource.data);

        allow delete: if isAdmin();
      }
    }
  }
}